# ── Recipe-Snap environment ───────────────────────────────────────────────
# Copy to `.env` and fill in. Variables prefixed EXPO_PUBLIC_ are inlined into
# the app bundle (safe for the anon key — NEVER put service-role or OpenAI keys
# here; those live only as Supabase function secrets, set separately).
#
# The app runs fully offline against seeded data if these are left blank.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (Project Settings → API)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Function secrets (NOT used by the app; set via the Supabase CLI) ────────
# supabase secrets set OPENAI_API_KEY=sk-...
# supabase secrets set OPENAI_MODEL=gpt-4o-mini   # optional, defaults to gpt-4o-mini
